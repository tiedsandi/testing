# Git CLONE:
- git clone git@github.com:username/repo.git
- git clone git@github-kerja:username/repo.git


# Tes SSH:
- ssh -T git@github.com
- ssh -T git@github-kerja

# Edit SSH:
- nano ~/.ssh/config

# ===============================
# --- GitHub Pribadi (DEFAULT) ---
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# --- GitHub Kerja ---
Host github-kerja
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github_kerja
  IdentitiesOnly yes
